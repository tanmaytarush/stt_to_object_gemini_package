# Copy to .env and fill in. Loaded by `python -m voice_logging` if present.
# Never put a real GEMINI_API_KEY in this file.

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required unless passed as --contractor-id. Never inferred from speech.
CONTRACTOR_ID=1

# The order screen's dropdowns. Both optional, like the screen. Voice never
# sets these, or the order type below.
CLIENT_ID=
DEALER_ID=

# MAT_ORDER (an actual order) or MAT_LIST (a list that is not an order yet).
ORDER_TYPE=MAT_ORDER

# Sent as the X-USER-ID header; drives created_by/updated_by audit columns.
STARSHIP_USER_ID=1

# Where the Go service is listening (PORT in the repo's .env is 8092).
STARSHIP_BASE_URL=http://localhost:8092

# Supported languages for the product (docs / --lock-languages only).
# Live STT does NOT send this list: Gemini hears the utterance and picks
# the language itself. A multi-code hint list made Hindi overwrite Kannada.
# Lock one language only if you must: --languages kn-IN
# Other Indic codes: ta-IN te-IN ml-IN bn-IN pa-IN as-IN or-IN
STT_LANGUAGES=hi-IN,gu-IN,mr-IN,kn-IN,en-IN
